; Inno Setup 6 Script for Insight Data Recovery Studio Pro
; Commercial Distribution Installer (x64 Native, Elevated Forensic Privileges)

#define MyAppName "Insight Data Recovery Studio Pro"
#define MyAppVersion "2.0.0"
#define MyAppPublisher "Insight Tools"
#define MyAppURL "https://insight-tools.local"
#define MyAppExeName "InsightRecovery.exe"

[Setup]
; App Identity
AppId={{5D9F28A1-4F29-41BE-B981-8973CE1D83E0}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Destination Directories (64-bit native Program Files)
DefaultDirName={autopf}\Insight Tools\Insight Data Recovery
DefaultGroupName=Insight Tools\Insight Data Recovery
AllowNoIcons=yes
OutputDir=Output
OutputBaseFilename=Setup_InsightRecovery_Pro_v2.0.0

; Embedded Branding, Visual Wizard Images & Commercial Icon
SetupIconFile=embedded\insight_recovery.ico
WizardImageFile=embedded\WizardImage0.bmp
WizardSmallImageFile=embedded\WizardSmallImage0.bmp
LicenseFile=embedded\License.rtf

; Wizard Appearance
DisableWelcomePage=no
WizardStyle=modern

; Compression & Optimization
Compression=lzma2/ultra64
SolidCompression=yes

; Architecture: Native 64-bit Windows Binary
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64

; Privileges: Forensic Data Recovery Requires Elevation
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked; OnlyBelowVersion: 6.1; Check: not IsAdminInstallMode

[Files]
; Dist files generated by PyInstaller
Source: "dist\InsightRecovery\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

; Embedded branding, license, and assets packaged into app
Source: "embedded\insight_recovery.ico"; DestDir: "{app}\assets"; Flags: ignoreversion
Source: "embedded\License.rtf"; DestDir: "{app}"; Flags: ignoreversion
Source: "embedded\License.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "embedded\*"; DestDir: "{app}\embedded"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\assets\insight_recovery.ico"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\assets\insight_recovery.ico"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent shellexec
